<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The module is loaded into pwsh's own process; copying the reference assembly would shadow the real one. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
    <!-- pwsh ships its own (newer) copy, which is the one loaded at run time. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MegaProvider.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="MegaProvider.format.ps1xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native host is built separately (scripts/dev.ps1 -Native); ship whatever build exists. -->
  <PropertyGroup>
    <HostExe>$(MSBuildThisFileDirectory)..\..\native\build\Release\megaprovider-host.exe</HostExe>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(HostExe)')">
    <None Include="$(HostExe)" Link="megaprovider-host.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

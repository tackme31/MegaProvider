<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <!-- Get-MegaRubbishItem inserts this type name; listed first so it wins over the MegaItem view. -->
    <View>
      <Name>MegaRubbishItem</Name>
      <ViewSelectedBy>
        <TypeName>MegaProvider.MegaRubbishItem</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Mode</Label><Width>4</Width></TableColumnHeader>
          <TableColumnHeader><Label>LastWriteTime</Label><Width>16</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Length</Label><Width>14</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Handle</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Mode</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>'{0,10} {1,5}' -f $_.LastWriteTime.ToString('d'), $_.LastWriteTime.ToString('t')</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Length</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Handle</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>MegaItem</Name>
      <ViewSelectedBy>
        <TypeName>MegaProvider.Backend.MegaItem</TypeName>
      </ViewSelectedBy>
      <GroupBy>
        <!-- PSParentPath is provider-qualified ("MegaProvider\Mega::photos\2024"); show it as a drive path. -->
        <ScriptBlock>"$($_.PSDrive.Name):$([IO.Path]::DirectorySeparatorChar)" + ($_.PSParentPath -replace '^.*?::[\\/]?', '')</ScriptBlock>
        <Label>Folder</Label>
      </GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Mode</Label><Width>4</Width></TableColumnHeader>
          <TableColumnHeader><Label>LastWriteTime</Label><Width>16</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Length</Label><Width>14</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Mode</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>'{0,10} {1,5}' -f $_.LastWriteTime.ToString('d'), $_.LastWriteTime.ToString('t')</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Length</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>MegaLinkInfo</Name>
      <ViewSelectedBy>
        <TypeName>MegaProvider.MegaLinkInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ExpiresAt</Label><Width>16</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
          <TableColumnHeader><Label>Url</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>if ($_.IsTakenDown) { 'taken down' } elseif ($_.IsExpired) { 'expired' } elseif ($_.ExpiresAt) { '{0,10} {1,5}' -f $_.ExpiresAt.ToString('d'), $_.ExpiresAt.ToString('t') }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Url</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
